  "components": {
    "securitySchemes": {
      "session": {
        "type": "apiKey",
        "in": "cookie",
        "name": "threads.sid"
      }
    },
    "parameters": {
      "PostId": {
        "name": "id",
        "in": "path",
        "required": true,
        "schema": {
          "type": "string",
          "format": "uuid"
        }
      },
      "Origin": {
        "name": "Origin",
        "in": "header",
        "required": true,
        "schema": {
          "type": "string"
        }
      },
      "CsrfToken": {
        "name": "X-CSRF-Token",
        "in": "header",
        "required": true,
        "schema": {
          "type": "string"
        }
      }
    },
    "schemas": {
      "Post": {
        "type": "object",
        "required": [
          "id",
          "status",
          "current_version",
          "revision"
        ],
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "status": {
            "type": "string",
            "enum": [
              "draft",
              "submitted",
              "approved",
              "rejected"
            ]
          },
          "current_version": {
            "type": "integer"
          },
          "revision": {
            "type": "integer"
          }
        }
      },
      "PostDetail": {
        "allOf": [
          {
            "$ref": "#/components/schemas/Post"
          },
          {
            "type": "object",
            "required": [
              "body",
              "created_by",
              "created_at",
              "updated_at"
            ],
            "properties": {
              "body": {
                "type": "string"
              },
              "created_by": {
                "type": "string",
                "format": "uuid"
              },
              "created_at": {
                "type": "string",
                "format": "date-time"
              },
              "updated_at": {
                "type": "string",
                "format": "date-time"
              },
              "destination_account_id": {
                "type": [
                  "string",
                  "null"
                ],
                "format": "uuid",
                "description": "Akun Threads aktif; null berarti belum dipilih."
              },
              "destination_username": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "job_id": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "job_status": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "scheduled_at": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "time_zone": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "published_id": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "failure_code": {
                "type": ["string", "null"],
                "enum": ["meta_auth", "meta_rejected", "meta_unavailable", "preconditions", "token_unreadable", "deadline", null],
                "description": "Kode diagnosis aman; tidak memuat respons mentah Meta atau token."
              }
            }
          }
        ]
      },
      "Csrf": {
        "type": "object",
        "required": [
          "csrfToken"
        ],
        "properties": {
          "csrfToken": {
            "type": "string"
          }
        }
      },
      "User": {
        "type": "object",
        "required": [
          "id",
          "email",
          "role",
          "emailVerified"
        ],
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "email": {
            "type": "string"
          },
          "role": {
            "type": "string",
            "enum": [
              "admin",
              "reviewer",
              "editor"
            ]
          },
          "emailVerified": {
            "type": "boolean"
          }
        }
      },
      "Error": {
        "type": "object",
        "required": [
          "error"
        ],
        "properties": {
          "error": {
            "type": "string"
          }
        }
      }
    },
    "responses": {
      "Post": {
        "description": "Status dan revisi konten",
        "content": {
          "application/json": {
            "schema": {
              "type": "object",
              "required": [
                "post"
              ],
              "properties": {
                "post": {
                  "$ref": "#/components/schemas/Post"
                }
              }
            }
          }
        }
      },
      "Error": {
        "description": "Permintaan gagal",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/Error"
            }
          }
        }
      },
      "RateLimit": {
        "description": "Batas percobaan terlampaui",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/Error"
            }
          }
        }
      }
    }
  }
}
