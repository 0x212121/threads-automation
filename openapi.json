{
  "openapi": "3.1.0",
  "info": {
    "title": "Threads Automation API (awal)",
    "version": "0.1.0",
    "description": "API awal untuk sesi browser. Integrasi mesin dan endpoint konten belum tersedia."
  },
  "paths": {
    "/health/live": {
      "get": {
        "operationId": "liveness",
        "responses": {
          "200": {
            "description": "Proses berjalan"
          }
        }
      }
    },
    "/health/ready": {
      "get": {
        "operationId": "readiness",
        "responses": {
          "200": {
            "description": "Database dapat dihubungi"
          },
          "503": {
            "description": "Database tidak dapat dihubungi"
          }
        }
      }
    },
    "/api/auth/csrf": {
      "get": {
        "operationId": "getCsrfToken",
        "description": "Membuat sesi anonim jika belum ada, dan mengembalikan token untuk login atau logout. Simpan cookie yang diberikan.",
        "responses": {
          "200": {
            "description": "Token CSRF",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Csrf"
                }
              }
            }
          },
          "429": {
            "$ref": "#/components/responses/RateLimit"
          }
        }
      }
    },
    "/api/auth/login": {
      "post": {
        "operationId": "login",
        "description": "Login lokal, memutar sesi dan token CSRF. Akun yang belum diverifikasi tetap ditandai emailVerified=false.",
        "parameters": [
          {
            "$ref": "#/components/parameters/Origin"
          },
          {
            "$ref": "#/components/parameters/CsrfToken"
          }
        ],
        "security": [
          {
            "session": []
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "email",
                  "password"
                ],
                "properties": {
                  "email": {
                    "type": "string",
                    "maxLength": 254
                  },
                  "password": {
                    "type": "string",
                    "format": "password"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Sesi baru dan token CSRF baru",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "user",
                    "csrfToken"
                  ],
                  "properties": {
                    "user": {
                      "$ref": "#/components/schemas/User"
                    },
                    "csrfToken": {
                      "type": "string"
                    }
                  }
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/Error"
          },
          "401": {
            "$ref": "#/components/responses/Error"
          },
          "403": {
            "$ref": "#/components/responses/Error"
          },
          "429": {
            "$ref": "#/components/responses/RateLimit"
          }
        }
      }
    },
    "/api/auth/me": {
      "get": {
        "operationId": "currentUser",
        "security": [
          {
            "session": []
          }
        ],
        "responses": {
          "200": {
            "description": "Pengguna aktif",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "user"
                  ],
                  "properties": {
                    "user": {
                      "$ref": "#/components/schemas/User"
                    }
                  }
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/Error"
          }
        }
      }
    },
    "/api/auth/logout": {
      "post": {
        "operationId": "logout",
        "security": [
          {
            "session": []
          }
        ],
        "parameters": [
          {
            "$ref": "#/components/parameters/Origin"
          },
          {
            "$ref": "#/components/parameters/CsrfToken"
          }
        ],
        "responses": {
          "204": {
            "description": "Sesi dicabut"
          },
          "403": {
            "$ref": "#/components/responses/Error"
          }
        }
      }
    },
    "/api/auth/verification/request": {
      "post": {
        "operationId": "requestEmailVerification",
        "security": [
          {
            "session": []
          }
        ],
        "description": "Kirim tautan verifikasi satu kali ke alamat email akun yang sedang masuk. Tautan berlaku 24 jam.",
        "parameters": [
          {
            "$ref": "#/components/parameters/Origin"
          },
          {
            "$ref": "#/components/parameters/CsrfToken"
          }
        ],
        "responses": {
          "204": {
            "description": "Permintaan diterima atau email sudah terverifikasi"
          },
          "401": {
            "$ref": "#/components/responses/Error"
          },
          "403": {
            "$ref": "#/components/responses/Error"
          },
          "429": {
            "$ref": "#/components/responses/RateLimit"
          },
          "503": {
            "$ref": "#/components/responses/Error"
          }
        }
      }
    },
    "/api/auth/verification/confirm": {
      "post": {
        "operationId": "confirmEmailVerification",
        "security": [
          {
            "session": []
          }
        ],
        "description": "Konfirmasi token untuk akun yang sedang masuk.",
        "parameters": [
          {
            "$ref": "#/components/parameters/Origin"
          },
          {
            "$ref": "#/components/parameters/CsrfToken"
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "token"
                ],
                "additionalProperties": false,
                "properties": {
                  "token": {
                    "type": "string"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "204": {
            "description": "Email terverifikasi"
          },
          "400": {
            "$ref": "#/components/responses/Error"
          },
          "401": {
            "$ref": "#/components/responses/Error"
          },
          "403": {
            "$ref": "#/components/responses/Error"
          }
        }
      }
    },
    "/api/auth/password-reset/request": {
      "post": {
        "operationId": "requestPasswordReset",
        "security": [
          {
            "session": []
          }
        ],
        "description": "Respons tidak mengungkap keberadaan akun. Tautan berlaku satu jam.",
        "parameters": [
          {
            "$ref": "#/components/parameters/Origin"
          },
          {
            "$ref": "#/components/parameters/CsrfToken"
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "email"
                ],
                "additionalProperties": false,
                "properties": {
                  "email": {
                    "type": "string",
                    "maxLength": 254
                  }
                }
              }
            }
          }
        },
        "responses": {
          "204": {
            "description": "Permintaan diterima"
          },
          "400": {
            "$ref": "#/components/responses/Error"
          },
          "403": {
            "$ref": "#/components/responses/Error"
          },
          "429": {
            "$ref": "#/components/responses/RateLimit"
          },
          "503": {
            "$ref": "#/components/responses/Error"
          }
        }
      }
    },
    "/api/auth/password-reset/confirm": {
      "post": {
        "operationId": "confirmPasswordReset",
        "security": [
          {
            "session": []
          }
        ],
        "description": "Tautan satu kali mengubah kata sandi dan mencabut semua sesi lama.",
        "parameters": [
          {
            "$ref": "#/components/parameters/Origin"
          },
          {
            "$ref": "#/components/parameters/CsrfToken"
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "token",
                  "password"
                ],
                "additionalProperties": false,
                "properties": {
                  "token": {
                    "type": "string"
                  },
                  "password": {
                    "type": "string",
                    "minLength": 12,
                    "format": "password"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "204": {
            "description": "Kata sandi diubah"
          },
          "400": {
            "$ref": "#/components/responses/Error"
          },
          "403": {
            "$ref": "#/components/responses/Error"
          },
          "429": {
            "$ref": "#/components/responses/RateLimit"
          }
        }
      }
    },
    "/api/invitations": {
      "post": {
        "operationId": "inviteMember",
        "security": [
          {
            "session": []
          }
        ],
        "description": "Administrator dengan email terverifikasi mengirim undangan berlaku 7 hari.",
        "parameters": [
          {
            "$ref": "#/components/parameters/Origin"
          },
          {
            "$ref": "#/components/parameters/CsrfToken"
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "email",
                  "role"
                ],
                "additionalProperties": false,
                "properties": {
                  "email": {
                    "type": "string"
                  },
                  "role": {
                    "type": "string",
                    "enum": [
                      "admin",
                      "reviewer",
                      "editor"
                    ]
                  }
                }
              }
            }
          }
        },
        "responses": {
          "204": {
            "description": "Undangan dikirim"
          },
          "400": {
            "$ref": "#/components/responses/Error"
          },
          "401": {
            "$ref": "#/components/responses/Error"
          },
          "403": {
            "$ref": "#/components/responses/Error"
          },
          "429": {
            "$ref": "#/components/responses/RateLimit"
          },
          "503": {
            "$ref": "#/components/responses/Error"
          }
        }
      }
    },
    "/api/invitations/accept": {
      "post": {
        "operationId": "acceptInvitation",
        "security": [
          {
            "session": []
          }
        ],
        "description": "Penerima membuat akun lokal menggunakan token undangan satu kali. Sesi harus anonim.",
        "parameters": [
          {
            "$ref": "#/components/parameters/Origin"
          },
          {
            "$ref": "#/components/parameters/CsrfToken"
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "token",
                  "password"
                ],
                "additionalProperties": false,
                "properties": {
                  "token": {
                    "type": "string"
                  },
                  "password": {
                    "type": "string",
                    "format": "password",
                    "minLength": 12
                  }
                }
              }
            }
          }
        },
        "responses": {
          "204": {
            "description": "Akun berhasil dibuat"
          },
          "400": {
            "$ref": "#/components/responses/Error"
          },
          "403": {
            "$ref": "#/components/responses/Error"
          },
          "409": {
            "$ref": "#/components/responses/Error"
          },
          "429": {
            "$ref": "#/components/responses/RateLimit"
          }
        }
      }
    },
    "/api/posts": {
      "get": {
        "operationId": "listPosts",
        "security": [
          {
            "session": []
          }
        ],
        "description": "Semua anggota aktif dapat membaca draft tim dan status publikasi. Maksimal 50 per halaman.",
        "parameters": [
          {
            "name": "offset",
            "in": "query",
            "schema": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740941,
              "default": 0
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Daftar draft dan nextOffset",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "posts",
                    "nextOffset"
                  ],
                  "properties": {
                    "posts": {
                      "type": "array",
                      "items": {
                        "$ref": "#/components/schemas/PostDetail"
                      }
                    },
                    "nextOffset": {
                      "type": [
                        "integer",
                        "null"
                      ]
                    }
                  }
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/Error"
          },
          "401": {
            "$ref": "#/components/responses/Error"
          }
        }
      },
      "post": {
        "operationId": "createPost",
        "security": [
          {
            "session": []
          }
        ],
        "parameters": [
          {
            "$ref": "#/components/parameters/Origin"
          },
          {
            "$ref": "#/components/parameters/CsrfToken"
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "body"
                ],
                "additionalProperties": false,
                "properties": {
                  "body": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 5000
                  },
                  "destinationAccountId": {
                    "type": [
                      "string",
                      "null"
                    ],
                    "format": "uuid",
                    "description": "Akun Threads aktif; null berarti belum dipilih."
                  }
                }
              }
            }
          }
        },
        "responses": {
          "201": {
            "$ref": "#/components/responses/Post"
          },
          "400": {
            "$ref": "#/components/responses/Error"
          },
          "401": {
            "$ref": "#/components/responses/Error"
          },
          "403": {
            "$ref": "#/components/responses/Error"
          }
        }
      }
    },
    "/api/posts/{id}": {
      "put": {
        "operationId": "editPost",
        "security": [
          {
            "session": []
          }
        ],
        "description": "Hanya pembuat dapat mengubah draft. Perubahan konten yang disetujui membatalkan persetujuan.",
        "parameters": [
          {
            "$ref": "#/components/parameters/PostId"
          },
          {
            "$ref": "#/components/parameters/Origin"
          },
          {
            "$ref": "#/components/parameters/CsrfToken"
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "body",
                  "revision"
                ],
                "additionalProperties": false,
                "properties": {
                  "body": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 5000
                  },
                  "revision": {
                    "type": "integer",
                    "minimum": 1
                  },
                  "destinationAccountId": {
                    "type": [
                      "string",
                      "null"
                    ],
                    "format": "uuid",
                    "description": "Jika tidak dikirim, akun tujuan sebelumnya dipertahankan."
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "$ref": "#/components/responses/Post"
          },
          "400": {
            "$ref": "#/components/responses/Error"
          },
          "401": {
            "$ref": "#/components/responses/Error"
          },
          "403": {
            "$ref": "#/components/responses/Error"
          },
          "409": {
            "$ref": "#/components/responses/Error"
          }
        }
      }
    },
    "/api/posts/{id}/{action}": {
      "post": {
        "operationId": "transitionPost",
        "security": [
          {
            "session": []
          }
        ],
        "description": "Pembuat mengajukan draft. Hanya admin atau reviewer dapat menyetujui atau menolak.",
        "parameters": [
          {
            "$ref": "#/components/parameters/PostId"
          },
          {
            "name": "action",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "enum": [
                "submit",
                "approve",
                "reject"
              ]
            }
          },
          {
            "$ref": "#/components/parameters/Origin"
          },
          {
            "$ref": "#/components/parameters/CsrfToken"
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "revision"
                ],
                "additionalProperties": false,
                "properties": {
                  "revision": {
                    "type": "integer",
                    "minimum": 1
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "$ref": "#/components/responses/Post"
          },
          "400": {
            "$ref": "#/components/responses/Error"
          },
          "401": {
            "$ref": "#/components/responses/Error"
          },
          "403": {
            "$ref": "#/components/responses/Error"
          },
          "409": {
            "$ref": "#/components/responses/Error"
          }
        }
      }
    },
    "/api/threads/accounts": {
      "get": {
        "operationId": "listThreadsAccounts",
        "security": [
          {
            "session": []
          }
        ],
        "description": "Daftar akun aktif untuk semua anggota; tidak memuat token.",
        "responses": {
          "200": {
            "description": "Akun aktif",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "accounts"
                  ],
                  "properties": {
                    "accounts": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "required": [
                          "id",
                          "username",
                          "status"
                        ],
                        "properties": {
                          "id": {
                            "type": "string",
                            "format": "uuid"
                          },
                          "username": {
                            "type": "string"
                          },
                          "status": {
                            "type": "string",
                            "enum": [
                              "active"
                            ]
                          }
                        }
                      }
                    }
                  }
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/Error"
          }
        }
      }
    },
    "/api/threads/config": {
      "get": {
        "operationId": "threadsConfig",
        "security": [
          {
            "session": []
          }
        ],
        "responses": {
          "200": {
            "description": "Status konfigurasi",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "configured",
                    "publishingEnabled"
                  ],
                  "properties": {
                    "configured": {
                      "type": "boolean"
                    },
                    "publishingEnabled": {
                      "type": "boolean"
                    }
                  }
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/Error"
          }
        }
      }
    },
    "/api/threads/oauth/start": {
      "post": {
        "operationId": "startThreadsOAuth",
        "security": [
          {
            "session": []
          }
        ],
        "parameters": [
          {
            "$ref": "#/components/parameters/Origin"
          },
          {
            "$ref": "#/components/parameters/CsrfToken"
          }
        ],
        "description": "Admin terverifikasi memulai otorisasi; state terikat pada sesi.",
        "responses": {
          "200": {
            "description": "URL otorisasi Meta",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "authorizationUrl"
                  ],
                  "properties": {
                    "authorizationUrl": {
                      "type": "string",
                      "format": "uri"
                    }
                  }
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/Error"
          },
          "403": {
            "$ref": "#/components/responses/Error"
          },
          "503": {
            "$ref": "#/components/responses/Error"
          }
        }
      }
    },
    "/api/threads/oauth/callback": {
      "get": {
        "operationId": "threadsOAuthCallback",
        "security": [
          {
            "session": []
          }
        ],
        "description": "Redirect dari Meta; state berlaku sekali dan terikat sesi admin. Jangan mencatat query callback pada log proxy.",
        "parameters": [
          {
            "name": "state",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "code",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "error",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "303": {
            "description": "Kembali ke aplikasi: #threads=connected atau #threads=failed&reason=TAHAP. Tahap kegagalan: configuration, access, session, denied, callback, code_exchange, long_token, profile, storage. meta_code opsional hanya berisi kode numerik Meta. Tidak menyertakan kode otorisasi, token, secret, atau pesan mentah Meta. Callback tanpa cookie sesi diarahkan dengan reason=session."
          },
          "401": {
            "$ref": "#/components/responses/Error"
          }
        }
      }
    },
    "/api/posts/{id}/schedule": {
      "post": {
        "operationId": "schedulePost",
        "security": [
          {
            "session": []
          }
        ],
        "parameters": [
          {
            "$ref": "#/components/parameters/PostId"
          },
          {
            "$ref": "#/components/parameters/Origin"
          },
          {
            "$ref": "#/components/parameters/CsrfToken"
          }
        ],
        "description": "Pembuat, admin, atau reviewer terverifikasi menjadwalkan konten yang disetujui. Waktu lokal tidak boleh ambigu.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "revision",
                  "localTime",
                  "timeZone"
                ],
                "properties": {
                  "revision": {
                    "type": "integer",
                    "minimum": 1
                  },
                  "localTime": {
                    "type": "string",
                    "example": "2027-01-01T09:00"
                  },
                  "timeZone": {
                    "type": "string",
                    "example": "Asia/Makassar"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Pekerjaan publikasi",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "job"
                  ],
                  "properties": {
                    "job": {
                      "type": "object",
                      "required": [
                        "id",
                        "status",
                        "scheduled_at"
                      ],
                      "properties": {
                        "id": {
                          "type": "string",
                          "format": "uuid"
                        },
                        "status": {
                          "type": "string"
                        },
                        "scheduled_at": {
                          "type": "string",
                          "format": "date-time"
                        }
                      }
                    }
